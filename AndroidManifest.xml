<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.osmosis.lethe.agent"
    android:versionCode="1"
    android:versionName="1.0"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Settings.Global/Secure writes from the native settings forms
         (animation scale, lockscreen notification visibility) — signature
         permission, granted via the platform key. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- TYPE_KEYGUARD_DIALOG window for the lock-screen mascot — signature
         permission, granted via the platform key. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <!-- Tap the keyguard mascot → summon the bouncer via
         IWindowManager.dismissKeyguard. Plain `signature` (not
         signature|privileged), so the platform key grants it and it needs
         NO entry in privapp-permissions-*.xml. -->
    <uses-permission android:name="android.permission.CONTROL_KEYGUARD" />

    <!-- Mesh signaling (BLE heartbeat) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:label="LETHE"
        android:icon="@mipmap/ic_lethe"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:persistent="true">

        <!-- LetheActivity (the WebView host) was removed in #192: WebView is
             banned in system-UID processes (Android 7.0+), so it crash-looped
             on user builds. Every surface it hosted now ships as its own native
             activity — MascotActivity (home), ChatActivity, VoiceActivity, and
             the Theme/Lockscreen/Auto-Wipe settings forms — each with its own
             LAUNCHER or intent entry below. -->

        <!-- Voice assist handler — long-press home triggers LETHE -->
        <activity
            android:name="org.osmosis.lethe.LetheAssistActivity"
            android:label="LETHE"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Persistent notification service — always-on quick access -->
        <service
            android:name="org.osmosis.lethe.LetheNotificationService"
            android:exported="false">
        </service>

        <!-- Lock-screen mascot (persist.lethe.mascot.keyguard) -->
        <service
            android:name="org.osmosis.lethe.KeyguardMascotService"
            android:exported="false">
        </service>

        <!-- Quick Settings tile -->
        <service
            android:name="org.osmosis.lethe.LetheTileService"
            android:label="LETHE"
            android:icon="@mipmap/ic_lethe"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Boot receiver — start services on boot -->
        <receiver
            android:name="org.osmosis.lethe.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Dead man's switch check-in receiver -->
        <receiver
            android:name="org.osmosis.lethe.CheckinReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.CHECKIN_DUE" />
            </intent-filter>
        </receiver>

        <!-- DMS Stage 2 escalation — routes to AutoWipePolicy -->
        <receiver
            android:name="org.osmosis.lethe.DmsEscalateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.DMS_ESCALATE_STAGE2" />
            </intent-filter>
        </receiver>

        <!-- Check-in passphrase dialog -->
        <activity
            android:name="org.osmosis.lethe.CheckinDialogActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- DMS settings — passphrase-protected disable -->
        <activity
            android:name="org.osmosis.lethe.DeadmanSettingsActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.DEADMAN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Auto-wipe policy settings — native UI, WebView-free.
             The WebView-based LetheActivity is unreachable on user
             builds (system UID + WebView ban since Android 7.0;
             see lethe#151), so the auto-wipe panel ships as its own
             native activity. -->
        <activity
            android:name="org.osmosis.lethe.AutoWipeSettingsActivity"
            android:label="Auto-Wipe Policy"
            android:theme="@android:style/Theme.DeviceDefault"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.AUTOWIPE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Native voice surface (lethe#190, Route 3). Records on-device,
             transcribes through the local STT endpoint, hands the
             transcript to ChatActivity. Assist gestures land here via
             LetheAssistActivity. -->
        <activity
            android:name="org.osmosis.lethe.VoiceActivity"
            android:label="LETHE Voice"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Void launcher — the avatar as home screen. CATEGORY_HOME
             makes Android's default-launcher chooser offer this vs the
             legacy UI (Trebuchet); the stock UX stays one Settings
             toggle away. stateNotNeeded per the launcher contract. -->
        <activity
            android:name="org.osmosis.lethe.LauncherActivity"
            android:label="LETHE Home"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Native mascot presentation (lethe#189 phase 1, Route 3).
             Canvas-drawn guardian per docs/design/mascot-layers.md —
             first time the mascot renders on user builds. Tap opens
             chat. -->
        <activity
            android:name="org.osmosis.lethe.MascotActivity"
            android:label="LETHE Guardian"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="lethe.intent.MASCOT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Native chat surface for the local agent core (lethe#188,
             Route 3). Shows up in Trebuchet's app drawer as "LETHE Chat"
             so the conversation panel is reachable on user builds where
             the WebView-host activity crashes. -->
        <activity
            android:name="org.osmosis.lethe.ChatActivity"
            android:label="LETHE Chat"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="lethe.intent.CHAT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Theme settings — native UI, WebView-free (lethe#191,
             Route 3 per docs/design/launcher-architecture-routes.md).
             Writes the PROP_NAME_MAX-safe persist.lethe.th.* family
             consumed by the native launcher surfaces. -->
        <activity
            android:name="org.osmosis.lethe.ThemeSettingsActivity"
            android:label="Theme"
            android:theme="@android:style/Theme.DeviceDefault"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.THEME_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lockscreen settings — native UI, WebView-free (lethe#191).
             Drives the real enforcement surfaces: DPM keyguard features
             + owner info (Device Owner) and the Settings.Secure
             notification-visibility keys. -->
        <activity
            android:name="org.osmosis.lethe.LockscreenSettingsActivity"
            android:label="Lockscreen"
            android:theme="@android:style/Theme.DeviceDefault"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.LOCKSCREEN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Panic press monitor (5x power = wipe) -->
        <service
            android:name="org.osmosis.lethe.PanicPressService"
            android:exported="false" />

        <!-- BFU auto-reboot (lethe#100): return to BFU after inactivity -->
        <service
            android:name="org.osmosis.lethe.BfuRebootService"
            android:exported="false" />

        <!-- System-wide EXIF strip on share (lethe#109).
             Registers a high-priority handler for image/* and video/*
             ACTION_SEND so it appears at the top of the share sheet. -->
        <activity
            android:name="org.osmosis.lethe.ShareScrubberActivity"
            android:label="Strip metadata"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Mesh signaling (BLE heartbeat for dead man's switch) -->
        <service
            android:name="org.osmosis.lethe.LetheMeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Duress PIN receiver (silent wipe on fake unlock) -->
        <receiver
            android:name="org.osmosis.lethe.DuressPinReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.DURESS_UNLOCK" />
            </intent-filter>
        </receiver>

        <!-- OTA update notification receiver -->
        <receiver
            android:name="org.osmosis.lethe.OtaReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.OTA_AVAILABLE" />
            </intent-filter>
        </receiver>

        <!-- Provider-pair handoff from a partner OSmosis device.
             Manifest-declared (not registered in LetheActivity) so the
             pair flow works on user builds where the WebView-host
             activity crashes; see lethe#159. -->
        <receiver
            android:name="org.osmosis.lethe.PairReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="lethe.intent.PAIR" />
            </intent-filter>
        </receiver>

        <!-- Native pair-payload entry UI. Shows up in Trebuchet's app
             drawer as "LETHE Pair" so users can paste the JSON an
             OSmosis partner encodes into a QR — the in-WebView QR
             scanner is unreachable on user builds (lethe#159). Same
             write path as PairReceiver. -->
        <activity
            android:name="org.osmosis.lethe.PairEntryActivity"
            android:label="LETHE Pair"
            android:theme="@android:style/Theme.DeviceDefault"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="lethe.intent.PAIR_ENTRY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Native camera-based QR scanner for the pair flow (lethe#168).
             Launched from PairEntryActivity via startActivityForResult;
             returns the decoded payload string in EXTRA_PAYLOAD on
             RESULT_OK. Not a drawer launcher — the paste activity is
             the entry surface. -->
        <activity
            android:name="org.osmosis.lethe.PairScanActivity"
            android:label="Scan pair QR"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- Device Admin (promoted to Device Owner at first boot).
             Unlocks DPM.wipeData() — the working wipe path — and the
             stock setMaximumFailedPasswordsForWipe API. -->
        <receiver
            android:name="org.osmosis.lethe.LetheDeviceAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.ACTION_PASSWORD_FAILED" />
                <action android:name="android.app.action.ACTION_PASSWORD_SUCCEEDED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
